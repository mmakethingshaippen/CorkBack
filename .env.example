# CorkBack environment variables — copy to .env.local and fill in. Never commit real values.

# Supabase (Postgres data + email auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — server side only, for flyer extraction. Never expose to the client.
GEMINI_API_KEY=
# Optional: override the flyer-extraction model. Defaults to gemini-3.8-flash.
# Older flash models (1.5/2.0/2.5) are shut down or blocked for new keys.
GEMINI_MODEL=

# Resend — radius email alerts
RESEND_API_KEY=

# MapLibre uses free tiles; no key required for the default style.

# Cron secret — protects the hourly expiry sweep (/api/cron/expire). Set the same
# value in the Vercel cron Authorization header.
CRON_SECRET=
