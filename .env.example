# CorkBack environment variables — copy to .env.local and fill in. Never commit real values.

# Supabase (Postgres data + email auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — server side only, for flyer extraction. Never expose to the client.
GEMINI_API_KEY=
# Optional: override the flyer-extraction model. Defaults to gemini-3.8-flash.
# Older flash models (1.5/2.0/2.5) are shut down or blocked for new keys.
GEMINI_MODEL=

# Resend — radius email alerts (Stage 2). Server only; never exposed to client.
RESEND_API_KEY=
# From address for alert emails (defaults to CorkBack <alerts@corkback.app>).
ALERTS_FROM_EMAIL=
# Public app URL used to build posting links in alert emails (defaults to localhost:3000).
NEXT_PUBLIC_APP_URL=

# MapLibre uses free tiles; no key required for the default style.

# Cron secret — protects the hourly expiry sweep (/api/cron/expire). Set the same
# value in the Vercel cron Authorization header.
CRON_SECRET=

# Geocoder — server side only, for address search on the posting flow. Leave all empty to
# keep the geocoder disabled. It also needs the Supabase URL and service role key above.
# Endpoint, https only, no credentials in the URL. Defaults to the public Nominatim
# search endpoint (https://nominatim.openstreetmap.org/search).
GEOCODER_URL=
# Required. Format: name/version (contact), where contact is an email or an https URL,
# e.g. AppName/1.0 (https://your-site.example). Max 300 characters, no control characters.
GEOCODER_USER_AGENT=
# Optional Referer header. Falls back to NEXT_PUBLIC_APP_URL.
GEOCODER_REFERER=
# Optional provider API key. Ignored for the public Nominatim host.
GEOCODER_API_KEY=
# Optional query parameter name that carries the API key. Defaults to "key".
GEOCODER_API_KEY_PARAM=
# Required. Random secret of at least 32 characters, used to key the shared cache.
# Generate your own. Never commit a real value or reuse another secret.
GEOCODER_CACHE_SECRET=
